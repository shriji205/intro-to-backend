              "if (pm.response.code === 201) pm.collectionVariables.set('postId', pm.response.json().post._id);",
              "pm.test('Character fields', () => { const post = pm.response.json().post; pm.expect(post.name).to.eql('Lily'); pm.expect(post.age).to.eql(20); pm.expect(post.createdAt).to.be.a('string'); });"
            ]
          }
        }
