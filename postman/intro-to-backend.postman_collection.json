{
  "info": {
    "name": "Intro to Backend - Atlas tutorial",
    "description": "Run in order against the Atlas-backed server. Creates one demonstration user and one post; deletes that post. Login verifies credentials only. No Authorization header is needed.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000"
    },
    {
      "key": "username",
      "value": ""
    },
    {
      "key": "email",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "postId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 Health and initialize unique demo identity",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/"
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const suffix = Date.now().toString(36) + Math.random().toString(36).slice(2, 8);",
              "pm.collectionVariables.set('username', 'student_' + suffix);",
              "pm.collectionVariables.set('email', 'student_' + suffix + '@example.com');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Response is JSON', () => pm.response.to.be.json);",
              "pm.test('Health message', () => pm.expect(pm.response.json().message).to.eql('Backend is running successfully'));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Register user",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"email\": \"{{email}}\",\n  \"password\": \"12345678\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/v1/users/register"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "pm.test('Response is JSON', () => pm.response.to.be.json);",
              "if (pm.response.code === 201) pm.collectionVariables.set('userId', pm.response.json().user._id);",
              "pm.test('User has ID and no password', () => { const user = pm.response.json().user; pm.expect(user._id).to.match(/^[0-9a-f]{24}$/i); pm.expect(user).not.to.have.property('password'); });"
            ]
          }
        }
      ]
    },
